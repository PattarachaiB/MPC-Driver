(ftf
  (header
    (version 2.0)
    (unit DBUNIT)
  )
  (TechnologyContainer
    (technology SamacSys_Footprint
      (footprintLayer
        (layer Top (type Conductive))
        (layer Inner (type Conductive))
        (layer Bottom (type Conductive))
        (layer Silk-Top (type Symbolmark))
        (layer Silk-Bottom (type Symbolmark))
        (layer Resist-Top (type Solderresist))
        (layer Resist-Bottom (type Solderresist))
        (layer MetalMask-Top (type Metalmask))
        (layer MetalMask-Bottom (type Metalmask))
        (layer CompArea-Top (type Comparea))
        (layer CompArea-Bottom (type Comparea))
        (layer Assembly-Top (type Undefined))
        (layer Assembly-Bottom (type Undefined))
        (layer Hole (type Hole))
      )
    )
  )
  (footprintContainer
    (commonParameters
      (dimensionParameters
        (arrowLength 100000)
        (arrowAngle 15.000000)
        (dotDiameter 100000)
        (textFrameOffset 100000)
        (arrowOffset 100000)
        (dimAssistOffset 100000)
        (dimLineWidth 10000)
        (drawTextFrame NO)
        (textFrameRange ALL)
        (textClip NO)
        (standard JIS)
      )
    )
    (padstackGroups
      (padstackGroup default)
    )
    (pads
      (pad c267
        (photo FLASH)
        (panelUse NO)
        (geometry
          (circle 133500
            (pt 0 0)
          )
        )
      )
      (pad r267_267
        (photo FLASH)
        (panelUse NO)
        (geometry
          (rectangle
            (pt 0 0)
            (width 267000)
            (height 267000)
            (rAngle 0.000000)
            (outlineWidth 0)
            (fillWidth 0)
            (fillAngle 0.000000)
          )
        )
      )
    ); End of pads
    (padstacks
      (padstack c267h178
        (type PLATED)
        (throughMode THROUGH)
        (panelUse NO)
        (Hole (footLayer Hole)
          (geometry
            (circle 89000
              (pt 0 0)
            )
          )
        )
        (padSet (footLayer Top)
          (connect (pad c267))
          (noconnect (pad c267))
        )
        (padSet (footLayer Resist-Top)
          (connect (pad c267))
          (noconnect (pad c267))
        )
        (padSet (footLayer Resist-Bottom)
          (connect (pad c267))
          (noconnect (pad c267))
        )
        (padSet (footLayer Inner)
          (clearance (pad c267))
          (connect (pad c267))
          (noconnect (pad c267))
        )
        (padSet (footLayer Bottom)
          (connect (pad c267))
          (noconnect (pad c267))
        )
      )
      (padstack r267_267h178
        (type PLATED)
        (throughMode THROUGH)
        (panelUse NO)
        (Hole (footLayer Hole)
          (geometry
            (circle 89000
              (pt 0 0)
            )
          )
        )
        (padSet (footLayer Top)
          (connect (pad r267_267))
          (noconnect (pad r267_267))
        )
        (padSet (footLayer Resist-Top)
          (connect (pad r267_267))
          (noconnect (pad r267_267))
        )
        (padSet (footLayer Resist-Bottom)
          (connect (pad r267_267))
          (noconnect (pad r267_267))
        )
        (padSet (footLayer Inner)
          (clearance (pad r267_267))
          (connect (pad r267_267))
          (noconnect (pad r267_267))
        )
        (padSet (footLayer Bottom)
          (connect (pad r267_267))
          (noconnect (pad r267_267))
        )
      )
    ); End of padstacks
    (footprints
      (footprint "IXBL60N360"
        (polarity YES)
        (panelUse NO)
        (heelprint
          (layout
            (layer (footLayer Assembly-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -234000 317000
                        (width 20000)
                      )
                      (pt 1758000 317000
                        (width 20000)
                      )
                    )
                  )
