                  (line
                    (vertex
                      (pt -234000 -185000
                        (width 20000)
                      )
                      (pt -234000 317000
                        (width 20000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -234000 317000
                        (width 10000)
                      )
                      (pt 1758000 317000
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
